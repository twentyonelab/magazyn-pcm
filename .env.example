# ---------------------------------------------------------------------------
# Konfiguracja aplikacji magazynu PCM
#
# Skopiuj ten plik jako .env i uzupelnij haslo.
# Plik .env NIGDY nie trafia do repozytorium (jest w .gitignore).
# ---------------------------------------------------------------------------

# Zrodlo danych:
#   mock — syntetyczne dane, dziala bez laboratorium (do pracy nad aplikacja)
#   http — prawdziwy Miniserver, odpytywanie HTTP co 5 s
LOXONE_SOURCE=mock

# --- Miniserver (potrzebne tylko dla LOXONE_SOURCE=http) -------------------
LOXONE_HOST=192.168.1.27

# DWA KONTA W LOXONE CONFIG, jedno tutaj.
#
#   pcm-odczyt      tylko odczyt  -> TO KONTO wpisujemy ponizej
#   pcm-sterowanie  z prawem sterowania -> hasla TU NIE WPISUJEMY
#
# Oba zaklada sie przy jednym podejsciu do Loxone Config, bo zapis
# konfiguracji restartuje Miniserver — a drugi restart moglby wypasc
# w srodku wielotygodniowego testu.
#
# Dlaczego aplikacja uzywa konta bez prawa sterowania, mimo ze konto
# sterujace istnieje: ta aplikacja TYLKO CZYTA. Konto z prawem sterowania
# w tym pliku oznaczaloby, ze kazdy blad w kodzie moze przestawic zawor
# albo pompe w trakcie testu — a to nie zepsuta aplikacja, tylko niewazne
# wyniki badawcze bez sladu, skad sie wzialy.
#
# Nie uzywaj konta admin.
LOXONE_USER=
LOXONE_PASS=

# Timeout jednego zapytania do Miniservera (ms)
LOXONE_TIMEOUT_MS=4000

# --- Odpytywanie -----------------------------------------------------------
# Sondy 1-Wire odswiezaja sie co ~15 s, wiec 5 s jest z zapasem.
POLL_INTERVAL_MS=5000

# Wartosc starsza niz POLL_INTERVAL_MS * STALE_FACTOR jest oznaczana
# jako przestarzala.
STALE_FACTOR=3

# --- Wymienne zbiorniki (dwa zestawy sond) ---------------------------------
# Stanowisko ma dwa zbiorniki, kazdy z wlasnymi szescioma sondami, i pracuje
# z jednym naraz. Aplikacja sama rozpoznaje, ktory jest podlaczony — zestaw
# jest tozsamy z parafina, wiec rozpoznanie ustawia tez skale barwna.
#
# Zostaw PUSTE dla rozpoznawania automatycznego.
# Ustaw RT57HC albo RT8HC tylko wtedy, gdy detekcja nie potrafi rozstrzygnac
# (np. Loxone pokazuje dla odlaczonych sond ostatnia znana wartosc, wiec oba
# zestawy wygladaja na zywe).
FORCE_BANK=

# Co ile sekund sprawdzac ponownie, ktory zbiornik jest podlaczony.
# Dzieki temu wymiana zbiornika nie wymaga restartu aplikacji.
BANK_RECHECK_S=300

# --- Serwer ----------------------------------------------------------------
# 127.0.0.1 = tylko ten komputer (zapora Windows o nic nie pyta).
# Zmien na 0.0.0.0, gdy aplikacja ma byc widoczna z innych urzadzen w labie.
HOST=127.0.0.1
PORT=4000

# --- Historia pomiarow -----------------------------------------------------
# Zapis dziala od pierwszego dnia, nawet gdy interfejs jeszcze go nie pokazuje.
HISTORY_ENABLED=true

# sqlite  — docelowy zapis do bazy (zalecany)
# ndjson  — zapis do plikow tekstowych, awaryjne wyjscie bez zaleznosci natywnych
HISTORY_BACKEND=sqlite
HISTORY_DB=./data/pomiary.db
HISTORY_DIR=./data/history

# Co ile sekund zapisac wartosc, ktora sie nie zmienila (zeby w danych bylo
# widac roznice miedzy "stabilna temperatura" a "czujnik przestal odpowiadac").
HISTORY_HEARTBEAT_S=300

# --- Logi ------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Tabela temperatur wypisywana w konsoli co cykl odpytywania
CONSOLE_TABLE=true

# --- Dostep do aplikacji ---------------------------------------------------
# W sieci laboratorium logowanie tylko przeszkadza, wiec domyslnie jest
# wylaczone. WLACZ JE, zanim udostepnisz aplikacje z zewnatrz (tunel,
# publiczny adres IP) — bez tego kazdy, kto zna adres, widzi dane badawcze
# i moze zakladac oraz konczyc sesje.
#
# Hash wygenerujesz komenda:  npm run haslo -- "twoje haslo"
# Hasla nie zapisujemy nigdzie — tutaj trafia wylacznie hash scrypt.
AUTH_ENABLED=false
AUTH_PASSWORD_HASH=
AUTH_SESSION_DAYS=30

# Ustaw na true, gdy aplikacja chodzi po HTTPS — ciasteczko sesji nie bedzie
# wtedy wysylane po nieszyfrowanym polaczeniu.
AUTH_COOKIE_SECURE=false

# --- Mapa (Mapbox) ---------------------------------------------------------
# Token publiczny (pk.*). UWAGA: token publiczny NIE JEST sekretem — trafia do
# kodu strony i kazdy odwiedzajacy go zobaczy. Tak go zaprojektowano.
# Ochrona polega na ograniczeniu adresow (URL restrictions) w panelu Mapbox,
# nie na ukrywaniu. Prefiks VITE_ jest wymagany, zeby Vite go udostepnil.
VITE_MAPBOX_TOKEN=
