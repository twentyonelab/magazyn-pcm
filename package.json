{
  "name": "magazyn-pcm",
  "version": "0.1.0",
  "private": true,
  "description": "Wizualizacja stanowiska badawczego magazynu ciepla na materiale zmiennofazowym (PCM)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n serwer,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "start": "npm run start --workspace=server",
    "uuid": "npm run uuid --workspace=server",
    "baza": "npm run baza --workspace=server",
    "przerwy": "npm run przerwy --workspace=server",
    "haslo": "npm run haslo --workspace=server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "npm run build --workspace @magazyn-pcm/web -- --mode pages --base /magazyn-pcm/"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
